rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == "victoribitoye70@gmail.com";
    }
    function validMessage() {
      return request.resource.data.keys().hasAll(['name','email','subject','message','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() <= 254
        && request.resource.data.subject is string && request.resource.data.subject.size() > 0 && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 1500
        && request.resource.data.createdAt == request.time
        && (!('staffId' in request.resource.data) || (request.resource.data.staffId is string && request.resource.data.staffId.size() <= 100));
    }
    match /{collection}/{document} {
      allow read: if collection in ['events','staff','news','notices'];
      allow write: if collection in ['events','staff','news','notices'] && isAdmin();
    }
    match /messages/{message} {
      allow create: if validMessage();
      allow read, update, delete: if isAdmin();
    }
    function validApplication(uid) {
      let d = request.resource.data;
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && d.keys().hasOnly(['uid','reference','fullName','email','phone','dateOfBirth','programme','lastSchool','statement','status','createdAt','gender','stateOfOrigin','lga','address','entryMode','jambRegNo','jambScore','secondChoice','olevel','nextOfKinName','nextOfKinPhone','nextOfKinRelationship'])
        && d.keys().hasAll(['uid','reference','fullName','email','phone','programme','status','createdAt','gender','stateOfOrigin','lga','address','entryMode','nextOfKinName','nextOfKinPhone'])
        && d.uid == uid
        && d.reference is string && d.reference.matches('LU-[A-Z2-9]{6}')
        && d.email == request.auth.token.email
        && d.fullName is string && d.fullName.size() > 1 && d.fullName.size() <= 120
        && d.phone is string && d.phone.size() >= 7 && d.phone.size() <= 20
        && d.programme is string && d.programme.size() <= 120
        && (!('dateOfBirth' in d) || (d.dateOfBirth is string && d.dateOfBirth.size() <= 20))
        && (!('lastSchool' in d) || (d.lastSchool is string && d.lastSchool.size() <= 150))
        && (!('statement' in d) || (d.statement is string && d.statement.size() <= 1500))
        && d.gender in ['Male','Female']
        && d.stateOfOrigin is string && d.stateOfOrigin.size() > 1 && d.stateOfOrigin.size() <= 60
        && d.lga is string && d.lga.size() > 1 && d.lga.size() <= 80
        && d.address is string && d.address.size() > 4 && d.address.size() <= 250
        && d.entryMode in ['UTME','Direct Entry']
        && (!('jambRegNo' in d) || (d.jambRegNo is string && d.jambRegNo.size() >= 8 && d.jambRegNo.size() <= 14))
        && (!('jambScore' in d) || (d.jambScore is number && d.jambScore >= 0 && d.jambScore <= 400))
        && (!('secondChoice' in d) || (d.secondChoice is string && d.secondChoice.size() <= 120))
        && (!('olevel' in d) || (d.olevel is string && d.olevel.size() <= 600))
        && d.nextOfKinName is string && d.nextOfKinName.size() > 1 && d.nextOfKinName.size() <= 120
        && d.nextOfKinPhone is string && d.nextOfKinPhone.size() >= 7 && d.nextOfKinPhone.size() <= 20
        && (!('nextOfKinRelationship' in d) || (d.nextOfKinRelationship is string && d.nextOfKinRelationship.size() <= 60))
        && d.status == 'new'
        && d.createdAt == request.time;
    }
    match /applications/{appId} {
      allow create: if validApplication(appId);
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == appId);
      allow update, delete: if isAdmin();
    }
    match /{document=**} { allow read, write: if false; }
  }
}
